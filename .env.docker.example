# =========================================================
# Variables de Entorno para Docker Compose
# =========================================================
# Copia este archivo a .env antes de iniciar Docker Compose:
# cp .env.docker.example .env

# PUERTO DE LA APLICACIÓN WEB
PORT=3000

# BASE DE DATOS POSTGRESQL (Contenedor 'db')
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gestion_clinicas
DATABASE_URL=postgresql://postgres:postgres@db:5432/gestion_clinicas

# NOTA: Si deseas usar una base de datos externa (como Neon DB o AWS RDS),
# simplemente reemplaza DATABASE_URL por la cadena de conexión correspondiente:
# DATABASE_URL=postgresql://usuario:contrasena@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# AUTENTICACIÓN JWT
JWT_SECRET=cambiar-por-un-secreto-seguro-en-produccion-jwt-secret-key-123456
JWT_EXPIRES_IN=30d

# CORREO ELECTRÓNICO (SMTP - Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
SMTP_FROM=tu-email@gmail.com

# ENTORNO
NODE_ENV=production

# RECORDATORIOS / NOTIFICACIONES
CITA_REMINDER_DAYS_AHEAD=1
NOTIFICATIONS_TTL_DAYS=30

