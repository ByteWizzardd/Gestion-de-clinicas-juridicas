# Variables de entorno - GestiÃ³n de ClÃ­nicas JurÃ­dicas
# Copia este archivo a .env y completa los valores
# cp .env.example .env

# BASE DE DATOS
DATABASE_URL=postgresql://usuario:contraseÃ±a@host:5432/nombre_bd

# AUTENTICACIÃ“N JWT
# Obligatoria. Minimo 32 caracteres y un valor propio: la aplicacion se
# niega a arrancar con los ejemplos publicos de este repositorio.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duracion de la sesion. Antes eran 30d; se acorto porque un token no se
# puede revocar antes de que expire.
JWT_EXPIRES_IN=12h

# CORREO ELECTRÃ“NICO (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseÃ±a-de-aplicacion
SMTP_FROM=tu-email@gmail.com

# ENTORNO
NODE_ENV=development

# RECORDATORIOS / NOTIFICACIONES
# Días de anticipación para los recordatorios de citas (1 = mañana)
CITA_REMINDER_DAYS_AHEAD=1

# Días de retención de notificaciones (limpieza automática/manual)
NOTIFICATIONS_TTL_DAYS=30

# ALMACENAMIENTO DE ARCHIVOS (Vercel Blob)
# Token de lectura/escritura del Blob Store (Vercel > Storage > Blob > .env.local)
BLOB_READ_WRITE_TOKEN=
